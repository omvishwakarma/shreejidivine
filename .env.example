# Copy into Vercel → Environment Variables (Production + Preview)

MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/shreeji?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-secret
AUTH_SECRET=use-a-long-random-secret

# Google Sign-In (login + signup)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
# Authorized JavaScript origins: http://localhost:3000 and https://shreejidivinearoma.com
# Authorized redirect URIs: same origins (GIS button flow)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public site URL (used for email logo + links)
NEXT_PUBLIC_SITE_URL=https://shreejidivinearoma.com

# Razorpay Test Mode keys from https://dashboard.razorpay.com/app/keys
# Use the Key ID + Secret from the SAME generated pair. Restart `npm run dev` after changes.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Transactional email (Nodemailer / SMTP) — welcome + order emails
# Example: Gmail (App Password), Zoho, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@shreejidivinearoma.com
SMTP_PASS=your-app-password-or-smtp-password
EMAIL_FROM="Shreeji Divine <hello@shreejidivinearoma.com>"

# Instagram live feed (homepage strip)
# Create a Meta app → Instagram Graph / Instagram API with Instagram Login
# Use a long-lived access token. Business account ID is optional if token is
# from Instagram Login (uses /me/media).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── Production file uploads (REQUIRED on Vercel) ───────────────────────────
# Local `public/` uploads do NOT persist on Vercel. Pick ONE option below.
#
# Option A — Vercel Blob (recommended if hosted on Vercel)
# Vercel Dashboard → Storage → Create Blob store → connect to project
# Prefer a PUBLIC store for product images (browser can load URLs directly).
# If your store is PRIVATE, set BLOB_ACCESS=private (uploads are proxied via /api/blob).
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=
#
# Option B — Cloudinary (images + videos CDN)
# https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
