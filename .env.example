# Copy into Vercel → Environment Variables (Production + Preview)

MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/shreeji?retryWrites=true&w=majority
JWT_SECRET=use-a-long-random-secret
AUTH_SECRET=use-a-long-random-secret

# Public site URL (used for email logo + links)
NEXT_PUBLIC_SITE_URL=https://shreejidivinearoma.com

# Razorpay Test Mode keys from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Transactional email (Nodemailer / SMTP) — welcome + order emails
# Example: Gmail (App Password), Zoho, or any SMTP provider
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@shreejidivinearoma.com
SMTP_PASS=your-app-password-or-smtp-password
EMAIL_FROM="Shreeji Divine <hello@shreejidivinearoma.com>"
